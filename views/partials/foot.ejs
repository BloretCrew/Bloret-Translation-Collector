  <%
    // scripts must be passed via include(..., { scripts: [...] }) — template `var` is not visible here
    const _assetV = typeof assetV !== 'undefined' && assetV ? assetV : '1';
    const pageScripts = typeof scripts !== 'undefined' && Array.isArray(scripts) ? scripts : [];
    function withAssetV(src) {
      if (!src) return src;
      return src.indexOf('?') >= 0 ? src + '&v=' + _assetV : src + '?v=' + _assetV;
    }
  %>
  <script defer src="<%= withAssetV('/blora/blora.js') %>"></script>
  <script defer src="<%= withAssetV('/js/sf-icon.js') %>"></script>
  <script defer src="<%= withAssetV('/js/app.js') %>"></script>
  <script defer src="<%= withAssetV('/js/locale-picker.js') %>"></script>
  <% pageScripts.forEach(function (src) { %>
    <script defer src="<%= withAssetV(src) %>"></script>
  <% }) %>
</body>
</html>
