<%#
  Crowdin-style target language transfer picker.
  locals: selected (string[]), name (default targetLocales), modalId (optional)
%>
<%
  var fieldName = typeof name !== 'undefined' ? name : 'targetLocales';
  var selectedInput = Array.isArray(selected) ? selected.slice() : [];
  var selectedList = selectedInput.map(function (item) {
    return typeof item === 'string'
      ? { code: item, label: '' }
      : { code: item.locale || item.code, label: item.displayName || item.label || '' };
  }).filter(function (item) { return item.code; });
  var opts = typeof COMMON_LOCALES !== 'undefined' ? COMMON_LOCALES : [];
  var modalId = typeof modalId !== 'undefined' ? modalId : 'locale-picker-modal';
  var catalog = opts.map(function (o) {
    return { code: o.code, label: o.label };
  });
  selectedList.forEach(function (item) {
    var hit = catalog.find(function (o) { return o.code.toLowerCase() === item.code.toLowerCase(); });
    if (hit && item.label) hit.label = item.label;
    if (!hit) catalog.push({ code: item.code, label: item.label || item.code });
  });
  selectedList = selectedList.map(function (item) {
    var hit = catalog.find(function (o) { return o.code.toLowerCase() === item.code.toLowerCase(); });
    return { code: item.code, label: item.label || (hit ? hit.label : item.code) };
  });
  var instanceId = modalId + '-data';
%>
<div
  class="blora-field locale-transfer"
  data-locale-transfer
  data-field-name="<%= fieldName %>"
  data-modal-id="<%= modalId %>"
  data-json-id="<%= instanceId %>"
>
  <span class="blora-field__label">目标语言</span>
  <p class="blora-field__hint">点击「选择语言」打开对话框，将左侧语言添加到右侧即为选中</p>

  <div class="locale-transfer__summary">
    <div class="locale-transfer__tags" data-locale-tags aria-live="polite">
      <% if (!selectedList.length) { %>
        <span class="blora-text-faint" data-locale-empty>尚未选择语言</span>
      <% } else { %>
        <% selectedList.forEach(function (item) {
          var code = item.code;
          var label = item.label || code;
        %>
          <span class="locale-tag" data-code="<%= code %>">
            <span class="locale-tag__label"><%= label %></span>
            <span class="locale-tag__code"><%= code %></span>
          </span>
        <% }) %>
      <% } %>
    </div>
    <button
      type="button"
      class="blora-btn blora-btn--outline blora-btn--sm"
      data-blora-modal-open="<%= modalId %>"
    >
      选择语言…
    </button>
  </div>

  <div class="locale-transfer__inputs" data-locale-inputs>
    <% selectedList.forEach(function (item) {
      var code = item.code;
      var label = item.label || code;
    %>
      <input
        type="hidden"
        name="<%= fieldName %>"
        value="<%= code %>"
        data-display-name="<%= label %>"
      />
    <% }) %>
  </div>

  <script type="application/json" id="<%= instanceId %>">
<%- JSON.stringify({ catalog: catalog, selected: selectedList.map(function (item) { return item.code; }) }) %>
  </script>
</div>

<div class="blora-modal blora-modal--lg" id="<%= modalId %>">
  <div class="blora-modal__mask" data-blora-close></div>
  <div class="blora-modal__dialog locale-picker-dialog" role="dialog" aria-modal="true" aria-labelledby="<%= modalId %>-title">
    <div class="blora-modal__head">
      <h2 class="blora-modal__title" id="<%= modalId %>-title">选择目标语言</h2>
      <button type="button" class="blora-modal__close" data-blora-close aria-label="关闭">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
      </button>
    </div>
    <div class="blora-modal__body locale-picker-body">
      <div class="locale-picker-panes">
        <div class="locale-picker-pane">
          <div class="locale-picker-pane__head">
            <strong>全部语言</strong>
            <span class="blora-text-faint u-text-xs" data-avail-count></span>
          </div>
          <input type="search" class="blora-input" data-locale-search placeholder="搜索语言名称或代码…" autocomplete="off" />
          <ul class="locale-picker-list" data-locale-available role="listbox" aria-label="可选语言"></ul>
          <div class="locale-picker-custom">
            <span class="blora-field__label">添加自定义语言</span>
            <div class="locale-picker-custom__row">
              <input type="text" class="blora-input" data-custom-code placeholder="代码，如 yue" maxlength="16" />
              <input type="text" class="blora-input" data-custom-label placeholder="显示名（可选）" maxlength="40" />
              <button type="button" class="blora-btn blora-btn--secondary blora-btn--sm" data-custom-add>添加</button>
            </div>
            <p class="blora-field__hint">代码将作为 locale 标识写入项目</p>
          </div>
        </div>

        <div class="locale-picker-actions">
          <button type="button" class="blora-btn blora-btn--primary blora-btn--sm" data-move-right title="添加到已选">→</button>
          <button type="button" class="blora-btn blora-btn--outline blora-btn--sm" data-move-left title="从已选移除">←</button>
        </div>

        <div class="locale-picker-pane">
          <div class="locale-picker-pane__head">
            <strong>已选语言</strong>
            <span class="blora-text-faint u-text-xs" data-sel-count></span>
          </div>
          <ul class="locale-picker-list" data-locale-selected role="listbox" aria-label="已选语言"></ul>
          <p class="blora-text-faint u-text-xs locale-picker-tip">双击或使用中间箭头在两侧移动</p>
        </div>
      </div>
    </div>
    <div class="blora-modal__foot">
      <button type="button" class="blora-btn blora-btn--ghost" data-blora-close>取消</button>
      <button type="button" class="blora-btn blora-btn--primary" data-locale-confirm>确定</button>
    </div>
  </div>
</div>
