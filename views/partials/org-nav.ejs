<%
  /* Expects: org, orgSlug, roleLabel?, canManage?, canManageProjects?, activeNav: 'projects'|'members'|'settings' */
  var nav = typeof activeNav !== 'undefined' ? activeNav : 'projects';
  var showManage = typeof canManage !== 'undefined' && canManage;
  var showNew = typeof canManageProjects !== 'undefined' && canManageProjects;
%>
<header class="app-page-header">
  <div class="app-page-header__copy">
    <h1 class="blora-h2 sf-inline entity-title">
      <% if (org.iconUrl) { %>
        <img class="entity-icon entity-icon--lg" src="<%= org.iconUrl %>" alt="" width="36" height="36" />
      <% } else { %>
        <%- sfIcon('building.2.fill') %>
      <% } %>
      <%= org.name %>
    </h1>
    <p class="blora-text-muted u-mt-2">
      <% if (typeof roleLabel !== 'undefined' && roleLabel) { %>
        <span class="blora-badge blora-badge--pill"><%= roleLabel %></span>
        <span class="u-ml-1">·</span>
      <% } %>
      <% if (org.visibility === 'public') { %>
        <span class="blora-badge sf-inline--tight"><%- sfIcon('globe', { className: 'sf-icon--sm' }) %>公开</span>
        <span class="u-ml-1">·</span>
      <% } %>
      <%= org.description || '暂无简介' %>
    </p>
  </div>
  <div class="app-page-header__actions">
    <% if (showNew && nav === 'projects') { %>
      <a class="blora-btn blora-btn--primary" href="/app/o/<%= orgSlug %>/projects/new"><%- sfIcon('plus.circle') %>新建项目</a>
    <% } %>
  </div>
</header>

<nav class="app-tabs app-tabs--sticky" aria-label="组织分区">
  <a class="app-tabs__link<%= nav === 'projects' ? ' is-active' : '' %>" href="/app/o/<%= orgSlug %>"><%- sfIcon('folder') %>项目</a>
  <a class="app-tabs__link<%= nav === 'members' ? ' is-active' : '' %>" href="/app/o/<%= orgSlug %>/members"><%- sfIcon('person.2') %>成员</a>
  <% if (showManage) { %>
    <a class="app-tabs__link<%= nav === 'settings' ? ' is-active' : '' %>" href="/app/o/<%= orgSlug %>/settings"><%- sfIcon('gearshape') %>设置</a>
  <% } %>
</nav>
