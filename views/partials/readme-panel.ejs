<%
  /* Expects: readmeView { html, source, url, warning }, editHref?, canEditReadme? */
  var rv = typeof readmeView !== 'undefined' ? readmeView : null;
  var canEdit = typeof canEditReadme !== 'undefined' && canEditReadme;
  var edit = typeof editHref !== 'undefined' ? editHref : null;
  var hasContent = rv && rv.html;
  var hasWarning = rv && rv.warning;
%>
<% if (hasContent || hasWarning || canEdit) { %>
<section class="app-section readme-section">
  <% if (hasContent || hasWarning) { %>
    <div class="app-section-head">
      <div>
        <h2 class="blora-h3"><%- sfIcon('text.book.closed') %>README</h2>
        <% if (rv && rv.source === 'url' && rv.url) { %>
          <p class="blora-text-faint u-text-xs u-mt-1">
            <%= t('来源') %>
            <a href="<%= rv.url %>" target="_blank" rel="noopener noreferrer" class="blora-text-mono"><%= rv.url.length > 72 ? rv.url.slice(0, 72) + '…' : rv.url %></a>
          </p>
        <% } else if (rv && rv.source === 'inline') { %>
          <p class="blora-text-faint u-text-xs u-mt-1"><%= t('本地 Markdown') %></p>
        <% } %>
      </div>
      <% if (canEdit && edit) { %>
        <a class="blora-btn blora-btn--ghost blora-btn--sm" href="<%= edit %>"><%- sfIcon('square.and.pencil') %><%= t('编辑') %></a>
      <% } %>
    </div>

    <% if (hasWarning) { %>
      <div class="blora-alert blora-alert--warning u-mb-3"><%= rv.warning %></div>
    <% } %>

    <% if (hasContent) { %>
      <article class="readme-body">
        <%- rv.html %>
      </article>
    <% } %>
  <% } else if (canEdit && edit) { %>
    <div class="readme-cta">
      <span><%= t('尚未添加 README — 可写 Markdown，或挂 raw HTTPS 链接') %></span>
      <a class="blora-btn blora-btn--secondary blora-btn--sm" href="<%= edit %>"><%- sfIcon('plus.circle') %><%= t('添加 README') %></a>
    </div>
  <% } %>
</section>
<% } %>
