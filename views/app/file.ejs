<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<main class="app-main">
  <div class="blora-container blora-container--wide">
    <div class="blora-stack blora-stack--lg">
      <%- include('../partials/breadcrumbs', { crumbs: [
        { label: t('组织'), href: '/app' },
        { label: org.name, href: '/app/o/' + orgSlug },
        { label: project.name, href: '/app/o/' + orgSlug + '/p/' + projectSlug },
        { label: file.path }
      ] }) %>

      <header class="app-page-header">
        <div class="app-page-header__copy">
          <h1 class="blora-h2 blora-text-mono sf-inline" style="font-size:1.5rem"><%- sfIcon('document') %><%= file.path %></h1>
          <p class="blora-text-muted u-mt-2">
            <%= t('版本 r') %><%= file.sourceRevision %> ·
            <%= localeProgress[0] ? localeProgress[0].total : 0 %> <%= t('条字符串 · 更新于') %> <%= updatedAtLabel %>
          </p>
        </div>
        <div class="app-page-header__actions">
          <a class="blora-btn blora-btn--ghost" href="/app/o/<%= orgSlug %>/p/<%= projectSlug %>/sources"><%- sfIcon('arrow.left') %><%= t('源文件') %></a>
          <% if (defaultLocale && canEdit) { %>
            <a class="blora-btn blora-btn--primary" href="/app/o/<%= orgSlug %>/p/<%= projectSlug %>/translate?file=<%= file.id %>&locale=<%= defaultLocale %>"><%- sfIcon('translate') %><%= t('开始翻译') %></a>
          <% } %>
          <% if (canUpload) { %>
            <button type="button" id="delete-file-btn" class="blora-btn blora-btn--danger blora-btn--sm"
              data-org-slug="<%= orgSlug %>" data-project-slug="<%= projectSlug %>" data-file-id="<%= file.id %>" data-path="<%= file.path %>"><%- sfIcon('trash') %><%= t('删除文件') %></button>
          <% } %>
        </div>
      </header>

      <section class="app-section">
        <h2 class="blora-h3"><%- sfIcon('globe') %><%= t('按语言进度') %></h2>
        <% if (!localeProgress.length) { %>
          <p class="blora-text-muted"><%= t('项目尚未配置目标语言') %></p>
        <% } else { %>
          <div class="blora-table-wrap">
            <table class="blora-table progress-table">
              <thead>
                <tr>
                  <th><%= t('语言') %></th>
                  <th><%= t('进度') %></th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                <% localeProgress.forEach(function (p) { %>
                  <tr>
                    <td>
                      <strong><%= languageShortLabel(p.locale, p.displayName) %></strong>
                      <% if (p.displayName && String(p.displayName).trim().toLowerCase() !== String(p.locale).toLowerCase()) { %>
                        <span class="blora-text-mono blora-text-faint u-text-xs u-ml-1"><%= p.locale %></span>
                      <% } %>
                    </td>
                    <td>
                      <div class="blora-row blora-row--center u-gap-1">
                        <div class="blora-progress" data-value="<%= p.percent %>" style="flex:1">
                          <div class="blora-progress__bar">
                            <div class="blora-progress__fill" style="width:<%= p.percent %>%"></div>
                          </div>
                        </div>
                        <span class="blora-text-mono blora-text-faint u-text-xs"><%= p.translated %>/<%= p.total %> (<%= p.percent %>%)</span>
                      </div>
                    </td>
                    <td>
                      <div class="blora-row u-gap-1">
                        <% if (canEdit) { %>
                          <a class="blora-btn blora-btn--primary blora-btn--xs" href="/app/o/<%= orgSlug %>/p/<%= projectSlug %>/translate?file=<%= file.id %>&locale=<%= p.locale %>"><%- sfIcon('translate') %><%= t('翻译') %></a>
                        <% } %>
                        <% if (canExport) { %>
                          <a class="blora-btn blora-btn--ghost blora-btn--xs" href="/app/o/<%= orgSlug %>/p/<%= projectSlug %>/export"><%- sfIcon('square.and.arrow.down') %><%= t('导出页') %></a>
                        <% } %>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </section>
    </div>
  </div>
</main>
<%- include('../partials/foot', { scripts: ['/js/forms.js'] }) %>
