<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<main class="app-main">
  <div class="blora-container blora-container--wide">
    <div class="blora-stack blora-stack--lg">
      <%- include('../partials/breadcrumbs', { crumbs: [{ label: '组织', href: '/app' }, { label: org.name }] }) %>
      <%- include('../partials/org-nav', { activeNav: 'projects' }) %>

      <%- include('../partials/readme-panel', {
        readmeView: typeof readmeView !== 'undefined' ? readmeView : null,
        canEditReadme: canManage,
        editHref: '/app/o/' + orgSlug + '/settings?tab=readme'
      }) %>

      <section class="app-section">
        <% if (!projects.length) { %>
          <div class="blora-empty">
            <div class="blora-empty__icon"><%- sfIcon('folder') %></div>
            <div class="blora-empty__title">尚无项目</div>
            <div class="blora-empty__desc">创建项目后即可上传源文件并开始翻译</div>
            <% if (canManageProjects) { %>
              <div class="app-empty-actions">
                <a class="blora-btn blora-btn--primary" href="/app/o/<%= orgSlug %>/projects/new"><%- sfIcon('plus.circle') %>创建项目</a>
              </div>
            <% } %>
          </div>
        <% } else { %>
          <div class="blora-table-wrap">
            <table class="blora-table blora-table--striped">
              <thead>
                <tr>
                  <th>名称</th>
                  <th>源语言</th>
                  <th>目标语言</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                <% projects.forEach(function (p) { %>
                  <tr>
                    <td>
                      <a href="/app/o/<%= orgSlug %>/p/<%= p.slug %>" class="entity-title entity-title--link">
                        <% if (p.iconUrl) { %>
                          <img class="entity-icon entity-icon--sm" src="<%= p.iconUrl %>" alt="" width="22" height="22" />
                        <% } else { %>
                          <%- sfIcon('folder.fill', { className: 'sf-icon--sm' }) %>
                        <% } %>
                        <%= p.name %>
                      </a>
                      <div class="blora-text-faint blora-text-mono u-text-xs u-mt-2"><%= p.slug %></div>
                    </td>
                    <td><span class="blora-badge"><%= localeLabel(p.sourceLocale) %></span></td>
                    <td>
                      <div class="blora-row u-gap-1">
                        <% (p.targetLanguages || (p.targetLocales || []).map(function (l) { return { locale: l, displayName: null }; })).forEach(function (lang) { %>
                          <span class="blora-badge"><%= languageShortLabel(lang.locale, lang.displayName) %></span>
                        <% }) %>
                      </div>
                    </td>
                    <td>
                      <a class="blora-btn blora-btn--primary blora-btn--xs" href="/app/o/<%= orgSlug %>/p/<%= p.slug %>"><%- sfIcon('arrow.right') %>打开</a>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </section>
    </div>
  </div>
</main>
<%- include('../partials/foot') %>
