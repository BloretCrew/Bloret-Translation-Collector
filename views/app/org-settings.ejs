<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<%
  const settingsTab = typeof activeTab !== 'undefined' && activeTab ? activeTab : 'general';
%>
<main class="app-main">
  <div class="blora-container blora-container--wide">
    <div class="blora-stack blora-stack--lg">
      <%- include('../partials/breadcrumbs', { crumbs: [
        { label: '组织', href: '/app' },
        { label: org.name, href: '/app/o/' + orgSlug },
        { label: '设置' }
      ] }) %>
      <%- include('../partials/org-nav', { activeNav: 'settings' }) %>

      <div class="settings-layout" data-settings-tabs data-default-tab="general">
        <nav class="settings-nav" aria-label="设置分区">
          <a class="settings-nav__link<%= settingsTab === 'general' ? ' is-active' : '' %>" href="?tab=general" data-tab="general">基本信息</a>
          <a class="settings-nav__link<%= settingsTab === 'readme' ? ' is-active' : '' %>" href="?tab=readme" data-tab="readme">README</a>
          <a class="settings-nav__link" href="/app/o/<%= orgSlug %>/members">成员管理</a>
        </nav>

        <div class="settings-main">
          <section class="settings-panel blora-panel" data-tab-panel="general" <%= settingsTab === 'general' ? '' : 'hidden' %>>
            <header class="settings-panel__head">
              <div>
                <h2 class="blora-h3">基本信息</h2>
                <p class="blora-text-faint u-text-sm u-mt-1">组织名称与简介</p>
              </div>
            </header>
            <form id="org-settings-form" class="blora-stack u-mt-4" data-org-slug="<%= orgSlug %>" data-settings-section="general">
              <div id="form-error" class="blora-alert blora-alert--danger" hidden></div>
              <label class="blora-field">
                <span class="blora-field__label">组织名称</span>
                <input class="blora-input" name="name" required maxlength="80" value="<%= org.name %>" />
              </label>
              <label class="blora-field">
                <span class="blora-field__label">简介</span>
                <textarea class="blora-textarea" name="description" rows="3" maxlength="500"><%= org.description || '' %></textarea>
              </label>
              <label class="blora-field">
                <span class="blora-field__label">可见性</span>
                <select class="blora-select" name="visibility">
                  <option value="private" <%= (org.visibility || 'private') === 'private' ? 'selected' : '' %>>私有（仅成员可见）</option>
                  <option value="public" <%= org.visibility === 'public' ? 'selected' : '' %>>公开（登录用户可查看）</option>
                </select>
                <span class="blora-field__hint">公开组织允许任何已登录用户浏览组织首页、README 与公开项目；管理权限仍仅限成员。</span>
              </label>
              <p class="blora-text-faint u-text-xs">
                slug <code class="blora-code"><%= orgSlug %></code> 创建后不可修改。
              </p>
              <div class="settings-panel__footer">
                <button class="blora-btn blora-btn--primary" type="submit">保存</button>
              </div>
            </form>
          </section>

          <section class="settings-panel blora-panel" data-tab-panel="readme" <%= settingsTab === 'readme' ? '' : 'hidden' %>>
            <header class="settings-panel__head">
              <div>
                <h2 class="blora-h3">README</h2>
                <p class="blora-text-faint u-text-sm u-mt-1">展示在组织首页。若填写 URL，将优先从远程加载 Markdown。</p>
              </div>
            </header>
            <form id="org-readme-form" class="blora-stack u-mt-4" data-org-slug="<%= orgSlug %>">
              <div id="readme-form-error" class="blora-alert blora-alert--danger" hidden></div>
              <label class="blora-field">
                <span class="blora-field__label">README URL（可选）</span>
                <input class="blora-input blora-text-mono" name="readmeUrl" type="url" placeholder="https://raw.githubusercontent.com/org/repo/refs/heads/main/README.md" value="<%= org.readmeUrl || '' %>" />
                <span class="blora-field__hint">仅支持 HTTPS。示例：GitHub raw 链接。</span>
              </label>
              <label class="blora-field">
                <span class="blora-field__label">本地 Markdown（URL 不可用时的后备）</span>
                <textarea class="blora-textarea blora-text-mono" name="readme" rows="14" placeholder="# 关于本组织&#10;&#10;欢迎参与翻译……"><%= org.readme || '' %></textarea>
              </label>
              <div class="settings-panel__footer">
                <button class="blora-btn blora-btn--primary" type="submit">保存 README</button>
                <a class="blora-btn blora-btn--ghost" href="/app/o/<%= orgSlug %>">查看组织首页</a>
              </div>
            </form>
          </section>
        </div>
      </div>
    </div>
  </div>
</main>
<%- include('../partials/foot', { scripts: ['/js/forms.js', '/js/settings-tabs.js'] }) %>
