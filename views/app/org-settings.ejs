<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<main class="app-main">
  <div class="blora-container blora-container--wide">
    <div class="app-narrow blora-stack blora-stack--lg">
      <% var crumbs = [{ label: '组织', href: '/app' }, { label: org.name, href: '/app/o/' + orgSlug }, { label: '设置' }]; %>
      <%- include('../partials/breadcrumbs') %>
      <header class="app-page-header">
        <div class="app-page-header__copy"><h1 class="blora-h2">组织设置</h1></div>
        <div class="app-page-header__actions">
          <a class="blora-btn blora-btn--ghost" href="/app/o/<%= orgSlug %>">返回组织</a>
        </div>
      </header>
      <div class="blora-panel">
        <form id="org-settings-form" class="blora-stack" data-org-slug="<%= orgSlug %>">
          <div id="form-error" class="blora-alert blora-alert--danger" hidden></div>
          <label class="blora-field">
            <span class="blora-field__label">组织名称</span>
            <input class="blora-input" name="name" required maxlength="80" value="<%= org.name %>" />
          </label>
          <label class="blora-field">
            <span class="blora-field__label">简介</span>
            <textarea class="blora-textarea" name="description" rows="3" maxlength="500"><%= org.description || '' %></textarea>
          </label>
          <p class="blora-text-faint" style="font-size:13px">
            slug <code class="blora-code"><%= orgSlug %></code> 创建后不可修改。
          </p>
          <button class="blora-btn blora-btn--primary" type="submit">保存</button>
        </form>
      </div>
    </div>
  </div>
</main>
<% var scripts = ['/js/forms.js']; %>
<%- include('../partials/foot') %>
