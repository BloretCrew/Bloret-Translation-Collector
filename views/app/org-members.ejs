<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<main class="app-main">
  <div class="blora-container blora-container--wide">
    <div class="blora-stack blora-stack--lg">
      <%- include('../partials/breadcrumbs', { crumbs: [
        { label: t('组织'), href: '/app' },
        { label: org.name, href: '/app/o/' + orgSlug },
        { label: t('成员') }
      ] }) %>
      <%- include('../partials/org-nav', { activeNav: 'members' }) %>

      <section class="app-section">
        <div id="member-list" data-org-slug="<%= orgSlug %>" data-can-manage="<%= canManage ? '1' : '0' %>" data-current-user="<%= currentUserId %>">
          <div id="member-error" class="blora-alert blora-alert--danger" hidden></div>
          <div class="blora-table-wrap">
            <table class="blora-table">
              <thead>
                <tr>
                  <th><%= t('用户') %></th>
                  <th><%= t('角色') %></th>
                  <% if (canManage) { %><th><%= t('操作') %></th><% } %>
                </tr>
              </thead>
              <tbody>
                <% members.forEach(function (m) { %>
                  <tr data-user-id="<%= m.userId %>">
                    <td>
                      <div class="blora-row blora-row--center" style="gap:8px">
                        <% if (m.avatarUrl) { %>
                          <img src="<%= m.avatarUrl %>" alt="" width="28" height="28" style="border-radius:999px" />
                        <% } else { %>
                          <span class="blora-avatar blora-avatar--sm"><%= m.username[0].toUpperCase() %></span>
                        <% } %>
                        <%= m.username %>
                        <% if (m.userId === currentUserId) { %>
                          <span class="blora-badge blora-badge--pill" style="font-size:10px"><%= t('我') %></span>
                        <% } %>
                      </div>
                    </td>
                    <td>
                      <% if (canManage && m.role !== 'owner') { %>
                        <select class="blora-select member-role" data-user-id="<%= m.userId %>">
                          <option value="manager" <%= m.role === 'manager' ? 'selected' : '' %>><%= t('管理员') %></option>
                          <option value="proofreader" <%= m.role === 'proofreader' ? 'selected' : '' %>><%= t('审核员') %></option>
                          <option value="translator" <%= m.role === 'translator' ? 'selected' : '' %>><%= t('译者') %></option>
                          <option value="viewer" <%= m.role === 'viewer' ? 'selected' : '' %>><%= t('访客') %></option>
                        </select>
                      <% } else { %>
                        <%= roleLabels[m.role] %>
                      <% } %>
                    </td>
                    <% if (canManage) { %>
                      <td>
                        <% if (m.role !== 'owner') { %>
                          <button type="button" class="blora-btn blora-btn--danger blora-btn--xs member-remove" data-user-id="<%= m.userId %>" data-username="<%= m.username %>"><%- sfIcon('trash') %><%= t('移除') %></button>
                        <% } %>
                      </td>
                    <% } %>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>

        <% if (canManage) { %>
          <div class="blora-panel u-mt-4">
            <div class="blora-panel__header"><h3 class="blora-h4 sf-inline"><%- sfIcon('person.badge.plus') %><%= t('添加成员') %></h3></div>
            <form id="add-member-form" class="blora-row" style="align-items:flex-end;flex-wrap:wrap" data-org-slug="<%= orgSlug %>">
              <div id="add-member-error" class="blora-alert blora-alert--danger" style="width:100%" hidden></div>
              <label class="blora-field" style="flex:1;min-width:160px">
                <span class="blora-field__label"><%= t('PassPort 用户名') %></span>
                <input class="blora-input" name="username" required placeholder="username" />
              </label>
              <label class="blora-field">
                <span class="blora-field__label"><%= t('角色') %></span>
                <select class="blora-select" name="role">
                  <option value="manager"><%= t('管理员') %></option>
                  <option value="proofreader"><%= t('审核员') %></option>
                  <option value="translator" selected><%= t('译者') %></option>
                  <option value="viewer"><%= t('访客') %></option>
                </select>
              </label>
              <button class="blora-btn blora-btn--primary" type="submit"><%- sfIcon('person.badge.plus') %><%= t('添加成员') %></button>
            </form>
          </div>
        <% } %>
      </section>
    </div>
  </div>
</main>
<%- include('../partials/foot', { scripts: ['/js/forms.js'] }) %>
