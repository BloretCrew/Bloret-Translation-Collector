<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<main class="app-main app-main--editor">
  <div
    id="translation-editor"
    class="editor-shell"
    data-org-slug="<%= orgSlug %>"
    data-project-slug="<%= projectSlug %>"
    data-file-id="<%= fileId %>"
    data-locale="<%= locale %>"
    data-focus-string="<%= typeof focusString !== 'undefined' && focusString ? focusString : '' %>"
    data-can-edit="<%= canEdit ? '1' : '0' %>"
    data-can-approve="<%= typeof canApprove !== 'undefined' && canApprove ? '1' : '0' %>"
    data-can-mode-translate="<%= typeof canModeTranslate !== 'undefined' && canModeTranslate ? '1' : '0' %>"
    data-can-mode-proofread="<%= typeof canModeProofread !== 'undefined' && canModeProofread ? '1' : '0' %>"
    data-mode="<%= typeof initialMode !== 'undefined' && initialMode ? initialMode : 'readonly' %>"
    data-project-href="/app/o/<%= orgSlug %>/p/<%= projectSlug %>"
  >
    <header class="editor-chrome">
      <a class="editor-chrome__back blora-btn blora-btn--ghost blora-btn--sm" href="/app/o/<%= orgSlug %>/p/<%= projectSlug %>" title="<%= t('返回项目') %>">
        <%- sfIcon('arrow.left') %> <%= project.name %>
      </a>
      <div class="editor-chrome__context">
        <select
          class="blora-select blora-select--sm editor-chrome__select editor-chrome__select--file"
          id="editor-file"
          aria-label="<%= t('文件') %>"
          title="<%= t('源文件') %>"
        >
          <% files.forEach(function (f) {
            var pathParts = String(f.path || '').split(/[/\\]/);
            var fileBase = pathParts[pathParts.length - 1] || f.path;
          %>
            <option value="<%= f.id %>" title="<%= f.path %>" <%= f.id === fileId ? 'selected' : '' %>><%= fileBase %></option>
          <% }) %>
        </select>
        <select
          class="blora-select blora-select--sm editor-chrome__select editor-chrome__select--locale"
          id="editor-locale"
          aria-label="<%= t('目标语言') %>"
          title="<%= t('目标语言') %>"
        >
          <% (localeLanguages || locales.map(function (l) { return { locale: l, displayName: null }; })).forEach(function (language) { %>
            <option
              value="<%= language.locale %>"
              title="<%= languageLabel(language.locale, language.displayName) %>"
              <%= language.locale === locale ? 'selected' : '' %>
            ><%= languageShortLabel(language.locale, language.displayName) %></option>
          <% }) %>
        </select>
        <% var showTranslateMode = typeof canModeTranslate !== 'undefined' && canModeTranslate; %>
        <% var showProofreadMode = typeof canModeProofread !== 'undefined' && canModeProofread; %>
        <% if (showTranslateMode || showProofreadMode) { %>
          <div
            class="blora-segmented editor-chrome__mode"
            id="editor-mode"
            role="group"
            aria-label="<%= t('工作身份') %>"
            title="<%= t('按已有权限切换翻译 / 审核视角') %>"
          >
            <% if (showTranslateMode) { %>
              <button
                type="button"
                class="blora-segmented__item<%= initialMode === 'translate' ? ' is-active' : '' %>"
                data-mode="translate"
                aria-pressed="<%= initialMode === 'translate' ? 'true' : 'false' %>"
              ><%- sfIcon('translate', { className: 'sf-icon--sm' }) %><%= t('翻译') %></button>
            <% } %>
            <% if (showProofreadMode) { %>
              <button
                type="button"
                class="blora-segmented__item<%= initialMode === 'proofread' ? ' is-active' : '' %>"
                data-mode="proofread"
                aria-pressed="<%= initialMode === 'proofread' ? 'true' : 'false' %>"
              ><%- sfIcon('checkmark.circle', { className: 'sf-icon--sm' }) %><%= t('审核') %></button>
            <% } %>
          </div>
        <% } %>
      </div>
      <div
        class="editor-progress"
        id="editor-progress"
        role="img"
        aria-label="<%= t('翻译进度') %>"
        title="<%= t('绿：已批准 · 黄：有保存译文 · 灰：未翻译') %>"
      >
        <div class="editor-progress__track" id="editor-progress-track">
          <span class="editor-progress__seg editor-progress__seg--approved" id="editor-progress-approved" style="flex:0"></span>
          <span class="editor-progress__seg editor-progress__seg--suggested" id="editor-progress-suggested" style="flex:0"></span>
          <span class="editor-progress__seg editor-progress__seg--empty" id="editor-progress-empty" style="flex:1"></span>
        </div>
        <span class="editor-progress__text blora-text-mono u-text-xs" id="editor-progress-text">—</span>
      </div>
      <div class="editor-chrome__meta">
        <span class="editor-chrome__count blora-text-mono u-text-xs" id="editor-count" title="<%= t('当前列表 / 总数') %>">0/0</span>
        <a class="blora-btn blora-btn--ghost blora-btn--sm editor-chrome__settings" href="/app/settings" title="<%= t('用户设置 · 快捷键') %>"><%- sfIcon('gearshape') %><span class="editor-chrome__btn-label"><%= t('设置') %></span></a>
        <button type="button" class="blora-btn blora-btn--ghost blora-btn--sm editor-chrome__toggle" id="editor-toggle-list" aria-label="<%= t('切换字符串列表') %>" aria-expanded="false" aria-controls="editor-list-col"><%- sfIcon('list.bullet') %><span class="editor-chrome__btn-label"><%= t('列表') %></span></button>
        <button type="button" class="blora-btn blora-btn--ghost blora-btn--sm editor-chrome__toggle" id="editor-toggle-side" aria-label="<%= t('切换辅助面板') %>" aria-expanded="false" aria-controls="editor-side-col"><%- sfIcon('sidebar.right') %><span class="editor-chrome__btn-label"><%= t('辅助') %></span></button>
      </div>
    </header>

    <div id="editor-error" class="blora-alert blora-alert--danger editor-shell__alert" hidden></div>

    <div id="editor-loading" class="editor-shell__state app-loading">
      <%- include('../partials/loading', { layout: 'page', label: t('加载中...') }) %>
    </div>

    <div id="editor-body" class="editor-workspace" hidden>
      <button type="button" class="editor-drawer-backdrop" id="editor-drawer-backdrop" aria-label="<%= t('关闭侧栏') %>" tabindex="-1" hidden></button>
      <aside class="editor-col editor-col--list" id="editor-list-col" aria-label="<%= t('字符串列表') %>">
        <div class="editor-list-tools">
          <input
            class="blora-input blora-input--sm editor-list-tools__search"
            id="editor-q"
            type="search"
            placeholder="<%= t('搜索 key 或源文') %>"
            autocomplete="off"
            aria-label="<%= t('搜索') %>"
          />
          <div class="editor-list-tools__row">
            <select class="blora-select blora-select--sm editor-list-tools__filter" id="editor-filter" aria-label="<%= t('筛选状态') %>">
              <option value="all"><%= t('全部') %></option>
              <option value="todo"><%= t('待处理（未译+待批）') %></option>
              <option value="untranslated"><%= t('未翻译') %></option>
              <option value="pending"><%= t('有建议未批准') %></option>
              <option value="approved"><%= t('已批准') %></option>
            </select>
            <button class="blora-btn blora-btn--ghost blora-btn--sm blora-btn--icon" type="button" id="editor-refresh" title="<%= t('刷新列表') %>" aria-label="<%= t('刷新列表') %>"><%- sfIcon('arrow.clockwise') %></button>
          </div>
        </div>
        <div class="editor-list" id="editor-list" role="listbox"></div>
        <div id="editor-list-empty" class="editor-list-empty blora-text-muted u-text-sm" hidden>
          <span id="editor-list-empty-msg"><%= t('没有匹配的字符串') %></span><br />
          <span class="blora-text-faint u-text-xs"><%= t('试试调整筛选或搜索') %></span>
        </div>
      </aside>

      <section class="editor-col editor-col--main" aria-label="<%= t('翻译区') %>">
        <div id="editor-panel-empty" class="editor-main-empty blora-text-muted">
          <p class="editor-main-empty__desktop"><%= t('选择左侧字符串开始翻译') %></p>
          <p class="editor-main-empty__mobile"><%= t('点按顶部「列表」选择字符串开始翻译') %></p>
        </div>
        <div id="editor-panel-active" class="editor-main-active" hidden>
          <div class="editor-main-scroll">
            <div class="editor-string-head">
              <div class="editor-string-head__key blora-text-mono" id="editor-key"></div>
              <div class="collab-workflow" id="editor-workflow"></div>
            </div>

            <div class="editor-meta-block">
              <div class="blora-text-caps blora-text-faint"><%= t('源文 ·') %> <%= localeLabel(project.sourceLocale) %></div>
              <div class="blora-panel editor-source" id="editor-source"></div>
            </div>

            <div class="glossary-hits" id="editor-glossary" hidden>
              <div class="blora-text-caps blora-text-faint"><%= t('术语') %></div>
              <div id="editor-glossary-list" class="glossary-hits__list"></div>
            </div>

            <div class="editor-refs" id="editor-refs" aria-label="<%= t('参考译文') %>">
              <section class="editor-ref-panel editor-ref-panel--mt" id="editor-mt" aria-labelledby="editor-mt-heading">
                <div class="editor-ref-panel__head">
                  <h3 class="editor-ref-panel__title blora-text-caps blora-text-faint" id="editor-mt-heading"><%- sfIcon('globe', { className: 'sf-icon--sm' }) %><%= t('机器翻译 · MT') %></h3>
                  <button type="button" class="blora-btn blora-btn--ghost blora-btn--xs" id="editor-mt-run" hidden title="<%= t('调用在线机器翻译') %>"><%- sfIcon('sparkles') %><%= t('在线翻译') %></button>
                </div>
                <div id="editor-mt-list" class="mt-hits__list"></div>
              </section>
              <section class="editor-ref-panel editor-ref-panel--tm" id="editor-tm" aria-labelledby="editor-tm-heading">
                <div class="editor-ref-panel__head">
                  <h3 class="editor-ref-panel__title blora-text-caps blora-text-faint" id="editor-tm-heading"><%- sfIcon('rectangle.stack', { className: 'sf-icon--sm' }) %><%= t('翻译记忆 · TM') %></h3>
                </div>
                <div id="editor-tm-list" class="tm-hits__list"></div>
              </section>
            </div>
          </div>

          <div class="editor-compose" id="editor-compose">
            <p class="editor-compose__mode-hint blora-text-muted u-text-sm" id="editor-mode-hint" hidden>
              <%= t('当前为') %><strong><%= t('审核') %></strong><%= t('身份：请在右侧建议列表中批准或取消批准。写译文请切换到「翻译」。') %>
            </p>
            <label class="blora-field editor-compose__field">
              <span class="blora-field__label editor-compose__label">
                <%
                  var _locMeta = (localeLanguages || []).find(function (l) { return l.locale === locale; });
                  var _locDisplay = _locMeta ? _locMeta.displayName : null;
                %>
                <%= t('译文 ·') %> <%= languageLabel(locale, _locDisplay) %>
                <span class="save-hint" id="editor-save-hint" title="<%= t('Ctrl/⌘+Enter 保存并下一条 · Ctrl/⌘+S 仅保存') %>"><%= t('就绪') %></span>
              </span>
              <textarea
                class="blora-textarea editor-draft"
                id="editor-draft"
                rows="4"
                placeholder="<%= t('输入译文…') %>"
                <%= canEdit ? '' : 'readonly' %>
              ></textarea>
            </label>
            <div class="editor-compose__actions">
              <% if (canEdit) { %>
                <button type="button" class="blora-btn blora-btn--primary blora-btn--sm" id="editor-save-suggestion" title="Ctrl/⌘+Enter"><%- sfIcon('checkmark.circle') %><span class="editor-compose__btn-long"><%= t('保存并下一条') %></span><span class="editor-compose__btn-short"><%= t('保存·下一条') %></span></button>
                <button type="button" class="blora-btn blora-btn--ghost blora-btn--sm" id="editor-save-only" title="Ctrl/⌘+S"><%- sfIcon('square.and.arrow.down') %><span class="editor-compose__btn-long"><%= t('仅保存') %></span><span class="editor-compose__btn-short"><%= t('保存') %></span></button>
                <button
                  type="button"
                  class="blora-btn blora-btn--ghost blora-btn--sm"
                  id="editor-insert-source"
                  title="<%= t('在光标处插入源文') %>"
                ><%- sfIcon('text.alignleft') %><span class="editor-compose__btn-long"><%= t('插入原文') %></span><span class="editor-compose__btn-short"><%= t('原文') %></span></button>
                <div class="blora-dropdown editor-compose__more">
                  <button class="blora-btn blora-btn--ghost blora-btn--sm blora-btn--icon" type="button" data-blora-dropdown-trigger aria-label="<%= t('更多操作') %>"><%- sfIcon('ellipsis') %></button>
                  <div class="blora-dropdown-menu">
                    <button type="button" class="blora-dropdown-menu__item" id="editor-delete-suggestion"><%- sfIcon('trash') %><%= t('删除建议') %></button>
                    <button type="button" class="blora-dropdown-menu__item" id="editor-assign-task" hidden><%- sfIcon('person.badge.plus') %><%= t('指派任务') %></button>
                  </div>
                </div>
              <% } %>
              <span class="editor-compose__spacer"></span>
              <button type="button" class="blora-btn blora-btn--outline blora-btn--sm" id="editor-prev" title="<%= t('上一条 (↑)') %>"><%- sfIcon('chevron.left') %><%= t('上一条') %></button>
              <button type="button" class="blora-btn blora-btn--outline blora-btn--sm" id="editor-next" title="<%= t('下一条 (↓)') %>"><%= t('下一条') %><%- sfIcon('chevron.right') %></button>
            </div>
          </div>
        </div>
      </section>

      <aside class="editor-col editor-col--side" id="editor-side-col" aria-label="<%= t('辅助信息') %>">
        <div class="blora-tabs editor-side-tabs" data-blora-tabs id="editor-side-tabs">
          <div class="blora-tabs__nav editor-side-tabs__nav">
            <button type="button" class="blora-tabs__tab is-active" data-tab="0"><%- sfIcon('list.bullet', { className: 'sf-icon--sm' }) %><%= t('建议') %></button>
            <button type="button" class="blora-tabs__tab" data-tab="1"><%- sfIcon('photo', { className: 'sf-icon--sm' }) %><%= t('语境') %></button>
            <button type="button" class="blora-tabs__tab" data-tab="2"><%- sfIcon('bubble.left', { className: 'sf-icon--sm' }) %><%= t('讨论') %></button>
          </div>
          <div class="editor-side-tabs__body">
            <div class="blora-tabs__panel editor-side-panel" data-panel="suggestions">
              <div id="editor-suggestions" class="collab-suggestions__list"></div>
            </div>
            <div class="blora-tabs__panel editor-side-panel blora-hide" data-panel="contexts">
              <div id="editor-contexts" class="context-shots">
                <div id="editor-contexts-list" class="context-shots__list"></div>
                <div class="context-shots__upload u-mt-2">
                  <input type="file" id="editor-context-file" accept="image/*" class="blora-input blora-input--sm" />
                  <input type="text" id="editor-context-caption" class="blora-input blora-input--sm" placeholder="<%= t('说明（可选）') %>" />
                  <button type="button" class="blora-btn blora-btn--secondary blora-btn--sm" id="editor-context-upload"><%- sfIcon('photo') %><%= t('上传截图') %></button>
                </div>
              </div>
            </div>
            <div class="blora-tabs__panel editor-side-panel blora-hide" data-panel="comments">
              <div class="collab-comments">
                <div id="editor-comments" class="collab-comments__list"></div>
                <div class="collab-comments__compose">
                  <textarea class="blora-textarea" id="editor-comment-body" rows="2" placeholder="<%= t('讨论语境、术语…') %>"></textarea>
                  <button type="button" class="blora-btn blora-btn--secondary blora-btn--sm" id="editor-comment-send"><%- sfIcon('paperplane') %><%= t('发送') %></button>
                </div>
              </div>
            </div>
          </div>
        </div>
      </aside>
    </div>
  </div>
</main>
<%- include('../partials/foot', { scripts: ['/js/editor-shortcuts.js', '/js/translation-prefs.js', '/js/editor.js'] }) %>
