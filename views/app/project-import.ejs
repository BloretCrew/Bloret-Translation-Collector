<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<main class="app-main">
  <div class="blora-container blora-container--wide">
    <div class="blora-stack blora-stack--lg">
      <%- include('../partials/breadcrumbs', { crumbs: [
        { label: t('组织'), href: '/app' },
        { label: org.name, href: '/app/o/' + orgSlug },
        { label: project.name, href: '/app/o/' + orgSlug + '/p/' + projectSlug },
        { label: t('导入') }
      ] }) %>
      <%- include('../partials/project-nav', { activeNav: 'import' }) %>

      <section class="app-section">
        <div class="app-section-head">
          <div>
            <h2 class="blora-h3"><%- sfIcon('square.and.arrow.up') %><%= t('导入 / 更新源文件') %></h2>
            <p class="blora-text-muted u-text-sm u-mt-1">
              <%= t('上传或更新源语言文件。相同路径会按键合并：已有译文与建议全部保留；源文变更不会清空译文；新文件中消失的键会标为孤立（隐藏，不删译文）；内容未变则跳过。') %>
            </p>
          </div>
        </div>

        <div class="blora-panel upload-panel" id="upload-panel">
          <form id="upload-file-form" class="blora-stack" data-org-slug="<%= orgSlug %>" data-project-slug="<%= projectSlug %>">
            <div id="form-error" class="blora-alert blora-alert--danger" hidden></div>
            <div id="form-warnings" class="blora-alert blora-alert--warning" hidden></div>
            <div id="upload-result" class="blora-alert blora-alert--success" hidden></div>
            <label class="blora-field">
              <span class="blora-field__label"><%= t('选择文件（可多选）') %></span>
              <input class="blora-input" type="file" id="file-pick" accept=".json,.properties,application/json,text/plain" multiple />
            </label>
            <div id="upload-file-list" class="upload-file-list" hidden></div>
            <label class="blora-field" id="single-path-field">
              <span class="blora-field__label"><%= t('项目内路径（单文件时）') %></span>
              <input class="blora-input" name="path" id="file-path" pattern="[a-zA-Z0-9_./-]+\.(json|properties)" value="locales/common.json" placeholder="locales/common.json" />
            </label>
            <details class="app-advanced">
              <summary><%= t('高级：直接粘贴内容（单文件）') %></summary>
              <label class="blora-field u-mt-3">
                <span class="blora-field__label"><%= t('文件内容') %></span>
                <textarea class="blora-textarea blora-text-mono" name="content" id="file-content" rows="12" style="font-size:13px"></textarea>
              </label>
            </details>
            <p class="blora-text-muted u-text-xs">
              <%= t('支持') %> <code>.json</code><%= t('（嵌套 / 扁平 i18n）与') %> <code>.properties</code>。
              <%= t('导出会尽量按上传原文的缩进、键序与格式写出。') %>
            </p>
            <div class="blora-row">
              <button class="blora-btn blora-btn--primary" type="submit"><%- sfIcon('icloud.and.arrow.up') %><%= t('上传 / 更新') %></button>
              <a class="blora-btn blora-btn--ghost" href="/app/o/<%= orgSlug %>/p/<%= projectSlug %>/sources"><%- sfIcon('document') %><%= t('查看源文件') %></a>
            </div>
          </form>
        </div>

        <% if (files.length) { %>
          <div class="u-mt-6">
            <h3 class="blora-h4"><%= t('已有文件（') %><%= files.length %>）</h3>
            <p class="blora-text-muted u-text-xs u-mt-1"><%= t('点击「更新」可预填路径，再选择同名新文件即可合并，不会影响已有译文。') %></p>
            <ul class="import-existing-list u-mt-3">
              <% files.forEach(function (f) { %>
                <li class="blora-row blora-row--center u-gap-2 u-text-sm">
                  <span class="blora-text-mono"><%= f.path %></span>
                  <span class="blora-text-faint">· r<%= f.sourceRevision %> · <%= f.stringCount %> <%= t('条') %></span>
                  <button type="button" class="blora-btn blora-btn--ghost blora-btn--xs" data-prefill-path="<%= f.path %>"><%- sfIcon('arrow.triangle.2.circlepath') %><%= t('更新') %></button>
                </li>
              <% }) %>
            </ul>
          </div>
        <% } %>

        <% if (typeof canManageSettings !== 'undefined' && canManageSettings) { %>
        <section class="app-section u-mt-6">
          <div class="app-section-head">
            <div>
              <h3 class="blora-h3"><%- sfIcon('globe') %><%= t('机器翻译文件') %></h3>
              <p class="blora-text-muted u-text-sm u-mt-1">
                <%= t('上传目标语言的机器翻译 JSON，作为工作台「MT」侧栏参考与导出兜底。键路径须与源文件一致（嵌套用点号，如 a.b）；请选择对应目标语言后上传。') %>
              </p>
            </div>
          </div>

          <div class="blora-panel">
            <form id="mt-upload-form" class="blora-stack" data-org-slug="<%= orgSlug %>" data-project-slug="<%= projectSlug %>">
              <div id="mt-form-error" class="blora-alert blora-alert--danger" hidden></div>
              <div class="blora-row u-gap-3">
                <label class="blora-field" style="flex:1">
                  <span class="blora-field__label"><%= t('目标语言') %></span>
                  <select class="blora-select" id="mt-locale" required>
                    <% (targetLanguages || targetLocales.map(function (l) { return { locale: l, displayName: null }; })).forEach(function (lang) { %>
                      <option value="<%= lang.locale %>"><%= languageLabel(lang.locale, lang.displayName) %> (<%= lang.locale %>)</option>
                    <% }) %>
                  </select>
                </label>
                <label class="blora-field" style="flex:2">
                  <span class="blora-field__label"><%= t('机器翻译 JSON 文件') %></span>
                  <input class="blora-input" type="file" id="mt-file-pick" accept=".json,application/json,text/plain" />
                </label>
              </div>
              <label class="blora-field">
                <span class="blora-field__label"><%= t('高级：直接粘贴内容') %></span>
                <textarea class="blora-textarea blora-text-mono" id="mt-content" rows="8" placeholder='{ "设置": "Настройки", ... }' style="font-size:13px"></textarea>
              </label>
              <div class="blora-row">
                <button class="blora-btn blora-btn--primary" type="submit"><%- sfIcon('icloud.and.arrow.up') %><%= t('上传机器翻译') %></button>
                <button class="blora-btn blora-btn--ghost" type="button" id="mt-clear"><%- sfIcon('trash') %><%= t('清空该语言机器翻译') %></button>
              </div>
            </form>
          </div>
        </section>
        <% } %>
      </section>
    </div>
  </div>
</main>
<%- include('../partials/foot', { scripts: ['/js/forms.js', '/js/mt-upload.js'] }) %>
