<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<main class="app-main">
  <div class="blora-container blora-container--wide">
    <div class="app-narrow blora-stack blora-stack--lg">
      <%- include('../partials/breadcrumbs', { crumbs: [{ label: t('组织'), href: '/app' }, { label: t('新建') }] }) %>
      <header class="app-page-header">
        <div class="app-page-header__copy">
          <h1 class="blora-h2 sf-inline"><%- sfIcon('building.2') %><%= t('新建组织') %></h1>
          <p class="blora-text-muted u-mt-2"><%= t('组织用于管理项目与成员协作。') %></p>
        </div>
      </header>
      <div class="blora-panel">
        <form id="create-org-form" class="blora-stack" method="post" action="/api/v1/orgs" onsubmit="return false;">
          <div id="form-error" class="blora-alert blora-alert--danger" hidden></div>
          <label class="blora-field">
            <span class="blora-field__label"><%= t('组织名称') %></span>
            <input class="blora-input" name="name" id="org-name" required maxlength="80" placeholder="<%= t('例如 Bloret Studio') %>" />
          </label>
          <details class="app-advanced">
            <summary><%= t('高级：URL 标识 (Slug)') %></summary>
            <label class="blora-field">
              <span class="blora-field__label">Slug</span>
              <input class="blora-input" name="slug" id="org-slug" required pattern="[a-z0-9]+(?:-[a-z0-9]+)*" placeholder="bloret-studio" />
              <span class="blora-field__hint"><%= t('根据名称自动生成，一般无需修改') %></span>
            </label>
          </details>
          <label class="blora-field">
            <span class="blora-field__label"><%= t('简介（可选）') %></span>
            <textarea class="blora-textarea" name="description" id="org-desc" rows="3" maxlength="500"></textarea>
          </label>
          <label class="blora-field">
            <span class="blora-field__label"><%= t('可见性') %></span>
            <select class="blora-select" name="visibility" id="org-visibility">
              <option value="private" selected><%= t('私有（仅成员可见）') %></option>
              <option value="public"><%= t('公开（登录用户可查看）') %></option>
            </select>
            <span class="blora-field__hint"><%= t('可在创建后于组织设置中修改。公开后访客仍只能访问标记为公开的项目。') %></span>
          </label>
          <div class="blora-row">
            <button class="blora-btn blora-btn--primary" type="submit"><%- sfIcon('checkmark.circle') %><%= t('创建组织') %></button>
            <a class="blora-btn blora-btn--ghost" href="/app"><%- sfIcon('xmark') %><%= t('取消') %></a>
          </div>
        </form>
      </div>
    </div>
  </div>
</main>
<%- include('../partials/foot', { scripts: ['/js/forms.js'] }) %>
