<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<main class="app-main">
  <div class="blora-container blora-container--wide">
    <div class="blora-stack blora-stack--lg">
      <%- include('../partials/breadcrumbs', { crumbs: [{ label: t('组织'), href: '/app' }, { label: org.name, href: '/app/o/' + orgSlug }, { label: project.name }] }) %>
      <%- include('../partials/project-nav', { activeNav: 'dashboard' }) %>

      <%
        var _canManageSettings = typeof canManageSettings !== 'undefined' && canManageSettings;
        var _canExport = typeof canExport !== 'undefined' && canExport;
        var _canEdit = typeof canEdit !== 'undefined' && canEdit;
        var _canUpload = typeof canUpload !== 'undefined' && canUpload;
        var _readmeView = typeof readmeView !== 'undefined' ? readmeView : null;
      %>
      <%- include('../partials/readme-panel', {
        readmeView: _readmeView,
        canEditReadme: _canManageSettings,
        editHref: '/app/o/' + orgSlug + '/p/' + projectSlug + '/settings?tab=readme'
      }) %>

      <section class="app-section">
        <div class="app-section-head">
          <h2 class="blora-h3"><%- sfIcon('globe') %><%= t('语言进度') %></h2>
          <% if (_canExport && targetLocales.length) { %>
            <a class="blora-btn blora-btn--ghost blora-btn--sm" href="/app/o/<%= orgSlug %>/p/<%= projectSlug %>/export"><%- sfIcon('square.and.arrow.down') %><%= t('前往导出') %></a>
          <% } %>
        </div>
        <% if (!targetLocales.length) { %>
          <div class="blora-empty">
            <div class="blora-empty__icon"><%- sfIcon('globe') %></div>
            <div class="blora-empty__title"><%= t('尚未配置目标语言') %></div>
            <div class="blora-empty__desc"><%= t('在设置中添加目标语言后即可开始翻译') %></div>
            <% if (_canManageSettings) { %>
              <div class="app-empty-actions">
                <a class="blora-btn blora-btn--primary" href="/app/o/<%= orgSlug %>/p/<%= projectSlug %>/settings"><%- sfIcon('gearshape') %><%= t('项目设置') %></a>
              </div>
            <% } %>
          </div>
        <% } else { %>
          <div class="blora-table-wrap">
            <table class="blora-table progress-table">
              <thead>
                <tr>
                  <th><%= t('语言') %></th>
                  <th><%= t('进度') %></th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                <% localeProgress.forEach(function (p) { %>
                  <tr>
                    <td>
                      <strong><%= languageShortLabel(p.locale, p.displayName) %></strong>
                      <% if (p.displayName && String(p.displayName).trim().toLowerCase() !== String(p.locale).toLowerCase()) { %>
                        <span class="blora-text-mono blora-text-faint u-text-xs u-ml-1"><%= p.locale %></span>
                      <% } %>
                    </td>
                    <td>
                      <div class="blora-row blora-row--center u-gap-1">
                        <div class="blora-progress" data-value="<%= p.percent %>" style="flex:1">
                          <div class="blora-progress__bar">
                            <div class="blora-progress__fill" style="width:<%= p.percent %>%"></div>
                          </div>
                        </div>
                        <span class="blora-text-mono blora-text-faint u-text-xs">
                          <%= t('批准') %> <%= p.translated %>/<%= p.total %> (<%= p.percent %>%)
                          · 有建议 <%= p.suggested != null ? p.suggested : 0 %>
                        </span>
                      </div>
                    </td>
                    <td>
                      <div class="blora-row u-gap-1">
                        <% if (defaultFile && _canEdit) { %>
                          <a class="blora-btn blora-btn--primary blora-btn--xs" href="/app/o/<%= orgSlug %>/p/<%= projectSlug %>/translate?file=<%= defaultFile %>&locale=<%= p.locale %>"><%- sfIcon('translate') %><%= t('进入工作台') %></a>
                        <% } else if (!defaultFile && _canUpload) { %>
                          <a class="blora-btn blora-btn--secondary blora-btn--xs" href="/app/o/<%= orgSlug %>/p/<%= projectSlug %>/import"><%- sfIcon('square.and.arrow.up') %><%= t('先导入文件') %></a>
                        <% } %>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </section>

      <section class="app-section">
        <div class="app-section-head">
          <h2 class="blora-h3"><%= t('源文件概览') %></h2>
          <a class="blora-btn blora-btn--ghost blora-btn--sm" href="/app/o/<%= orgSlug %>/p/<%= projectSlug %>/sources"><%= t('全部源文件 →') %></a>
        </div>
        <% if (!files.length) { %>
          <div class="blora-empty">
            <div class="blora-empty__title"><%= t('尚无源文件') %></div>
            <div class="blora-empty__desc"><%= t('导入 JSON 或 .properties 后即可翻译') %></div>
            <% if (_canUpload) { %>
              <div class="app-empty-actions">
                <a class="blora-btn blora-btn--primary" href="/app/o/<%= orgSlug %>/p/<%= projectSlug %>/import"><%= t('导入源文件') %></a>
              </div>
            <% } %>
          </div>
        <% } else { %>
          <div class="blora-table-wrap">
            <table class="blora-table blora-table--striped">
              <thead>
                <tr>
                  <th><%= t('路径') %></th>
                  <th><%= t('字符串') %></th>
                  <th><%= t('版本') %></th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                <% files.slice(0, 5).forEach(function (f) { %>
                  <tr>
                    <td class="blora-text-mono">
                      <a href="/app/o/<%= orgSlug %>/p/<%= projectSlug %>/files/<%= f.id %>"><%= f.path %></a>
                    </td>
                    <td><%= f.stringCount %></td>
                    <td>r<%= f.sourceRevision %></td>
                    <td>
                      <% if (defaultLocale && _canEdit) { %>
                        <a class="blora-btn blora-btn--primary blora-btn--xs" href="/app/o/<%= orgSlug %>/p/<%= projectSlug %>/translate?file=<%= f.id %>&locale=<%= defaultLocale %>"><%= t('翻译') %></a>
                      <% } %>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
          <% if (files.length > 5) { %>
            <p class="blora-text-muted u-text-sm u-mt-3">
              <%= t('另有') %> <%= files.length - 5 %> <%= t('个文件 ·') %>
              <a href="/app/o/<%= orgSlug %>/p/<%= projectSlug %>/sources"><%= t('查看全部') %></a>
            </p>
          <% } %>
        <% } %>
      </section>
    </div>
  </div>
</main>
<%- include('../partials/foot') %>
