<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<main class="app-main">
  <div class="blora-container blora-container--wide">
    <div class="app-narrow blora-stack blora-stack--lg">
      <%- include('../partials/breadcrumbs', { crumbs: [
        { label: '组织', href: '/app' },
        { label: org.name, href: '/app/o/' + orgSlug },
        { label: project.name, href: '/app/o/' + orgSlug + '/p/' + projectSlug },
        { label: '设置' }
      ] }) %>
      <header class="app-page-header">
        <div class="app-page-header__copy"><h1 class="blora-h2">项目设置</h1></div>
        <div class="app-page-header__actions">
          <a class="blora-btn blora-btn--ghost" href="/app/o/<%= orgSlug %>/p/<%= projectSlug %>">返回项目</a>
        </div>
      </header>
      <div class="blora-panel">
        <div class="blora-stack blora-stack--lg">
          <form id="project-settings-form" class="blora-stack" data-org-slug="<%= orgSlug %>" data-project-slug="<%= projectSlug %>">
            <div id="form-error" class="blora-alert blora-alert--danger" hidden></div>
            <label class="blora-field">
              <span class="blora-field__label">项目名称</span>
              <input class="blora-input" name="name" required value="<%= project.name %>" />
            </label>
            <label class="blora-field">
              <span class="blora-field__label">简介</span>
              <textarea class="blora-textarea" name="description" rows="2"><%= project.description || '' %></textarea>
            </label>
            <%- include('../partials/locale-source-select', { value: project.sourceLocale }) %>
            <label class="blora-field">
              <span class="blora-field__label">可见性</span>
              <select class="blora-select" name="visibility">
                <option value="org" <%= project.visibility === 'org' ? 'selected' : '' %>>组织内</option>
                <option value="private" <%= project.visibility === 'private' ? 'selected' : '' %>>私有</option>
              </select>
            </label>
            <%- include('../partials/locale-target-picker', { selected: targetLocales }) %>
            <p class="blora-text-faint" style="font-size:13px">
              Slug <code class="blora-code"><%= projectSlug %></code> 创建后不可修改。
            </p>
            <button class="blora-btn blora-btn--primary" type="submit">保存设置</button>
          </form>

          <hr class="blora-divider" />

          <section
            class="blora-stack"
            id="glossary-panel"
            data-org-slug="<%= orgSlug %>"
            data-project-slug="<%= projectSlug %>"
            data-locales="<%= targetLocales.join(',') %>"
          >
            <h3 class="blora-h4">术语表</h3>
            <p class="blora-text-muted">源文出现术语时，工作台会提示推荐译法（类似 Crowdin Glossary）。</p>
            <div id="glossary-list" class="glossary-list"></div>
            <form id="glossary-add-form" class="blora-stack">
              <div class="blora-grid blora-grid--2">
                <label class="blora-field">
                  <span class="blora-field__label">源术语</span>
                  <input class="blora-input" name="sourceTerm" required placeholder="例如：账号" />
                </label>
                <label class="blora-field">
                  <span class="blora-field__label">说明（可选）</span>
                  <input class="blora-input" name="description" placeholder="上下文备注" />
                </label>
              </div>
              <label class="blora-field">
                <span class="blora-field__label">目标语言译法（可选，可稍后在列表中补全）</span>
                <div class="blora-row" style="flex-wrap:wrap;gap:8px" id="glossary-tr-fields"></div>
              </label>
              <button type="submit" class="blora-btn blora-btn--secondary">添加术语</button>
            </form>
          </section>

          <hr class="blora-divider" />

          <section
            class="blora-stack"
            id="assignees-panel"
            data-org-slug="<%= orgSlug %>"
            data-project-slug="<%= projectSlug %>"
            data-locales="<%= targetLocales.join(',') %>"
          >
            <h3 class="blora-h4">语言负责人</h3>
            <p class="blora-text-muted">为某语言指派审核员（可批准该语言译文，无需全局审核员角色）。</p>
            <div id="assignees-list" class="assignees-list"></div>
            <form id="assignee-add-form" class="blora-row" style="align-items:flex-end;flex-wrap:wrap;gap:8px">
              <label class="blora-field">
                <span class="blora-field__label">语言</span>
                <select class="blora-select" name="locale" id="assignee-locale"></select>
              </label>
              <label class="blora-field">
                <span class="blora-field__label">用户名</span>
                <input class="blora-input" name="username" required placeholder="PassPort 用户名" />
              </label>
              <label class="blora-field">
                <span class="blora-field__label">职责</span>
                <select class="blora-select" name="kind">
                  <option value="proofreader">审核员</option>
                  <option value="translator">译者</option>
                </select>
              </label>
              <button type="submit" class="blora-btn blora-btn--secondary">添加指派</button>
            </form>
          </section>

          <hr class="blora-divider" />

          <div class="blora-stack">
            <h3 class="blora-h4">危险区域</h3>
            <p class="blora-text-muted">删除项目将清除所有源文件与译文，且无法恢复。</p>
            <button type="button" id="delete-project-btn" class="blora-btn blora-btn--danger" data-org-slug="<%= orgSlug %>" data-project-slug="<%= projectSlug %>" data-name="<%= project.name %>">删除项目</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</main>
<%- include('../partials/foot', { scripts: ['/js/forms.js', '/js/project-settings.js'] }) %>
