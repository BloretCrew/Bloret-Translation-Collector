<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<main class="app-main">
  <div class="blora-container blora-container--wide">
    <div class="app-narrow blora-stack blora-stack--lg">
      <% var crumbs = [
        { label: '组织', href: '/app' },
        { label: org.name, href: '/app/o/' + orgSlug },
        { label: project.name, href: '/app/o/' + orgSlug + '/p/' + projectSlug },
        { label: '设置' }
      ]; %>
      <%- include('../partials/breadcrumbs') %>
      <header class="app-page-header">
        <div class="app-page-header__copy"><h1 class="blora-h2">项目设置</h1></div>
        <div class="app-page-header__actions">
          <a class="blora-btn blora-btn--ghost" href="/app/o/<%= orgSlug %>/p/<%= projectSlug %>">返回项目</a>
        </div>
      </header>
      <div class="blora-panel">
        <div class="blora-stack blora-stack--lg">
          <form id="project-settings-form" class="blora-stack" data-org-slug="<%= orgSlug %>" data-project-slug="<%= projectSlug %>">
            <div id="form-error" class="blora-alert blora-alert--danger" hidden></div>
            <label class="blora-field">
              <span class="blora-field__label">项目名称</span>
              <input class="blora-input" name="name" required value="<%= project.name %>" />
            </label>
            <label class="blora-field">
              <span class="blora-field__label">简介</span>
              <textarea class="blora-textarea" name="description" rows="2"><%= project.description || '' %></textarea>
            </label>
            <div class="blora-grid blora-grid--2">
              <label class="blora-field">
                <span class="blora-field__label">源语言</span>
                <input class="blora-input" name="sourceLocale" required value="<%= project.sourceLocale %>" />
              </label>
              <label class="blora-field">
                <span class="blora-field__label">可见性</span>
                <select class="blora-select" name="visibility">
                  <option value="org" <%= project.visibility === 'org' ? 'selected' : '' %>>组织内</option>
                  <option value="private" <%= project.visibility === 'private' ? 'selected' : '' %>>私有</option>
                </select>
              </label>
            </div>
            <label class="blora-field">
              <span class="blora-field__label">目标语言（逗号分隔）</span>
              <input class="blora-input" name="targetLocales" required value="<%= targetLocales.join(', ') %>" placeholder="en, ja, ko" />
            </label>
            <p class="blora-text-faint" style="font-size:13px">
              Slug <code class="blora-code"><%= projectSlug %></code> 创建后不可修改。
            </p>
            <button class="blora-btn blora-btn--primary" type="submit">保存设置</button>
          </form>

          <hr class="blora-divider" />

          <div class="blora-stack">
            <h3 class="blora-h4">危险区域</h3>
            <p class="blora-text-muted">删除项目将清除所有源文件与译文，且无法恢复。</p>
            <button type="button" id="delete-project-btn" class="blora-btn blora-btn--danger" data-org-slug="<%= orgSlug %>" data-project-slug="<%= projectSlug %>" data-name="<%= project.name %>">删除项目</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</main>
<% var scripts = ['/js/forms.js']; %>
<%- include('../partials/foot') %>
